# Copy to .env and fill in your provider credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# Optional guardrails.
AEGIS_MAX_TOOL_ITERATIONS=20
AEGIS_MAX_OUTPUT_TOKENS=8192
